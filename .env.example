# Comma-separated frontend origins allowed to call the API.
# Local example:
# ALLOWED_ORIGINS=http://localhost:5173
#
# Production example:
# ALLOWED_ORIGINS=https://it-support-diagnostic-portal.vercel.app

ALLOWED_ORIGINS=http://localhost:5173,https://it-support-diagnostic-portal.vercel.app

# Database connection string.
# Local SQLite is used by default for development.
# Future production deployments can replace this with a hosted PostgreSQL URL.

DATABASE_URL=sqlite:///./supportops.db
